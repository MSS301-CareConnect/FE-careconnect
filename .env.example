# Browser requests use this prefix. Keep secrets out of VITE_* variables.
VITE_API_BASE_URL=/api

# Development-only reverse proxy target used by Vite (not exposed to the browser).
API_PROXY_TARGET=http://localhost:8080

# Development-only demo payment (pnpm dev). The dev server confirms demo deposits as a SERVICE client,
# like PaymentService after a VNPay IPN. Copy BOOKING_SERVICE_CLIENT_ID / BOOKING_SERVICE_CLIENT_SECRET
# from BE/BookingService/.env into .env (never into a VITE_* variable, never commit the secret).
PAYMENT_DEMO_SERVICE_CLIENT_ID=booking
PAYMENT_DEMO_SERVICE_CLIENT_SECRET=5tGm3xqcKKeWjQwFe_nA_Bc0g2egB8f0lonEQrSxei0
