# Browser requests use this prefix. Keep secrets out of VITE_* variables.
VITE_API_BASE_URL=/api

# Development-only reverse proxy target used by Vite (not exposed to the browser).
API_PROXY_TARGET=http://localhost:8080

# Payments go to the real PaymentService through the gateway. Set PaymentService VNPAY_RETURN_URL to
# <this app origin>/customer/payments/vnpay-return so VNPay sends the browser back to the result screen.
