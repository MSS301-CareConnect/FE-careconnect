{
  "name": "software-license-management-web",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "api:generate": "pnpm api:validate && orval --config ./orval.config.ts",
    "api:validate": "node ./scripts/validate-openapi.mjs ./openapi/openapi.yaml",
    "api:watch": "pnpm api:validate && orval --config ./orval.config.ts --watch",
    "build": "react-router build",
    "check": "pnpm prettier && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "react-router dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/*.test.mjs eslint-rules/*.test.cjs",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "isbot": "^5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router": "^8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/react-router": "^1.3.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "orval": "^8.24.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.3",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
